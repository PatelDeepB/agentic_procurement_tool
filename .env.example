# ==============================================================================
# Agentic Procurement Tool - Environment Configuration
# ==============================================================================
# Get your FREE Gemini API Key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# Free tier gives 15 Requests/Min, 1,500 Requests/Day at $0 cost.
# ==============================================================================

# Option 1: Google Gemini Free API (Recommended)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_free_gemini_api_key_here

# Option 2: OpenAI API (Optional)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here

# If no API key is provided, the tool automatically runs using the offline
# high-fidelity Mock LLM client so you can test and grade with 0 configuration!
